# Normalize line endings on checkin, checkout native.
* text=auto

# Explicit text types.
*.js       text eol=lf
*.jsx      text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
LICENSE    text eol=lf
Dockerfile text eol=lf

# Binary types.
*.png      binary
*.jpg      binary
*.ico      binary
*.woff2    binary
