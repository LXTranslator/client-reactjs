# Static server for the LXTranslator client bundle.
#
# Two jobs: serve the single page application, and forward /api to the backend
# so the browser sees one origin. A single origin means no cross origin
# preflight and no need to relax the backend's origin allowlist.
#
# This is a template, not a finished configuration. The nginx entrypoint renders
# every file in /etc/nginx/templates into /etc/nginx/conf.d at start up,
# substituting API_UPSTREAM, so the backend address is a deploy time setting
# rather than a value baked into the image. Only that variable and the
# resolver the entrypoint discovers are substituted; every other `$name` below
# is an nginx variable and survives untouched.

server {
    # Port 8080 rather than 80, so the server can run as an unprivileged user.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Do not advertise the server version.
    server_tokens off;

    # Security headers.
    #
    # The content security policy is deliberately tight: scripts and styles come
    # from this origin only, nothing may be framed, and connections are limited
    # to this origin because the API is proxied through it. Vite emits a plain
    # script bundle and a stylesheet, so no inline script allowance is needed.
    # `style-src` permits inline styles because a few components set layout
    # properties through the style attribute.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # The application handles confidential material, so it stays out of search
    # indexes.
    add_header X-Robots-Tag "noindex, nofollow" always;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Hashed asset filenames change whenever their contents do, so they can be
    # cached indefinitely.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # The shell must never be cached, or a deploy would leave browsers loading
    # an old bundle that references assets which no longer exist.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires 0;
    }

    # Forward API calls to the backend named by API_UPSTREAM: scheme and host,
    # no path and no trailing slash, for example http://server:4000 or
    # https://your_api_host.
    location /api/ {
        # The address is held in a variable so nginx resolves it per request
        # instead of once at start up. Resolving at start up means an upstream
        # that is unknown to DNS stops the whole server from booting, taking the
        # static site down with it, and it pins the first address for the life
        # of the process, which breaks whenever a hosting platform moves the
        # backend. With a variable an unreachable backend is a 502 on /api/ and
        # nothing more.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;

        proxy_http_version 1.1;

        # $proxy_host is the host from API_UPSTREAM, which is what the backend
        # must be addressed by. Sending this server's own host instead leaves a
        # platform that routes by hostname unable to tell which service the
        # request belongs to.
        proxy_set_header Host $proxy_host;

        # Send SNI on a TLS upstream, without which a shared edge cannot pick a
        # certificate and the handshake fails. Ignored for a plain http
        # upstream.
        proxy_ssl_server_name on;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The backend no longer sees the browser's host in the Host header, so
        # it is carried here instead.
        proxy_set_header X-Forwarded-Host $host;

        # Translation uploads can take a while to accept, so the read timeout is
        # generous. Processing itself is asynchronous and polled.
        proxy_read_timeout 120s;
        client_max_body_size 4m;
    }

    # Client side routing: any unmatched path falls through to the shell so a
    # deep link such as /namespaces/projects loads the application rather than
    # returning 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
